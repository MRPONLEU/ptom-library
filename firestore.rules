rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function isSignedIn() { return request.auth != null; }

    function isValidFileDocument(data) {
      return data.title is string && data.title.size() > 0 &&
             data.driveLink is string && data.driveLink.size() > 0 &&
             data.type is string && data.type.size() > 0;
    }

    // File content
    match /files/{fileId} {
      allow read: if true; // Public access
      allow create: if isSignedIn() && isValidId(fileId) && isValidFileDocument(request.resource.data);
      allow update: if isSignedIn() && isValidId(fileId);
      allow delete: if isSignedIn() && isValidId(fileId);
    }

    // File download statistics
    match /file_stats/{fileId} {
      // Anyone can read stats
      allow read: if true;
      // Anyone can increment stats (public download tracking)
      allow create, update: if true;
    }
  }
}
